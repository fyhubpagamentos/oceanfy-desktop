{
  "name": "oceanfy-desktop",
  "productName": "Oceanfy",
  "version": "0.3.9",
  "description": "Aplicativo desktop do Oceanfy (voz, vídeo e compartilhamento de tela)",
  "private": true,
  "main": "src/main.js",
  "author": "Oceanfy",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/fyhubpagamentos/oceanfy-desktop.git"
  },
  "scripts": {
    "dev": "cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .",
    "make-icon": "node scripts/make-icon.mjs",
    "build:frontend": "npm --prefix ../frontend run build",
    "dist": "npm run build:frontend && npm run make-icon && electron-builder --win nsis --config.directories.output=release-publish",
    "dist:publish": "npm run build:frontend && npm run make-icon && electron-builder --win nsis --publish always --config.directories.output=release-publish"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jimp": "^1.6.1"
  },
  "build": {
    "appId": "com.oceanfy.app",
    "productName": "Oceanfy",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "build/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "dist"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fyhubpagamentos",
        "repo": "oceanfy-desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Oceanfy-Setup-${version}.exe",
      "shortcutName": "Oceanfy",
      "createDesktopShortcut": true
    }
  }
}
